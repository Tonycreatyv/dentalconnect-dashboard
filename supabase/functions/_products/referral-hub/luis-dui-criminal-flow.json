{
  "version": "7.3",
  "routing_model": {
    "CRIMINAL_TOPIC": ["CRIMINAL_DETAILS"],
    "CRIMINAL_DETAILS": []
  },
  "screens": [
    {
      "id": "CRIMINAL_TOPIC",
      "title": "DUI / Defensa criminal",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Seleccioná el tipo de situación para conectarte con el profesional adecuado." },
          { "type": "RadioButtonsGroup", "name": "topic", "label": "Tipo de situación", "required": true, "data-source": [{ "id": "DUI", "title": "DUI" }, { "id": "ARREST", "title": "Arresto o detención" }, { "id": "CRIMINAL_CHARGE", "title": "Cargo criminal" }, { "id": "COURT_SUMMONS", "title": "Citación / corte" }, { "id": "OTHER", "title": "Otro" }] },
          { "type": "Footer", "label": "Continuar", "on-click-action": { "name": "navigate", "next": { "type": "screen", "name": "CRIMINAL_DETAILS" }, "payload": { "topic": "${form.topic}" } } }
        ]
      }
    },
    {
      "id": "CRIMINAL_DETAILS",
      "title": "Tus datos",
      "terminal": true,
      "success": true,
      "data": { "topic": { "type": "string", "__example__": "DUI" } },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextInput", "name": "full_name", "label": "Nombre completo", "required": true },
          { "type": "TextArea", "name": "description", "label": "Breve descripción de lo ocurrido", "required": true },
          { "type": "TextInput", "name": "postal_code", "label": "ZIP / código postal — opcional", "input-type": "number", "required": false },
          { "type": "Footer", "label": "Solicitar ayuda", "on-click-action": { "name": "complete", "payload": { "intake_type": "DUI_CRIMINAL", "topic": "${data.topic}", "full_name": "${form.full_name}", "postal_code": "${form.postal_code}", "description": "${form.description}" } } }
        ]
      }
    }
  ]
}
