{
  "version": "7.3",
  "routing_model": {
    "IMMIGRATION_TOPIC": ["IMMIGRATION_DETAILS"],
    "IMMIGRATION_DETAILS": []
  },
  "screens": [
    {
      "id": "IMMIGRATION_TOPIC",
      "title": "Ayuda de inmigración",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Seleccioná el tipo de ayuda que necesitás para conectarte con el profesional adecuado." },
          {
            "type": "RadioButtonsGroup",
            "name": "topic",
            "label": "Tipo de ayuda",
            "required": true,
            "data-source": [
              { "id": "CONSULTATION", "title": "Consulta de inmigración" },
              { "id": "GREEN_CARD", "title": "Residencia / Green Card" },
              { "id": "CITIZENSHIP", "title": "Ciudadanía" },
              { "id": "WORK_PERMIT", "title": "Permiso de trabajo" },
              { "id": "FAMILY_PETITION", "title": "Petición familiar" },
              { "id": "IMMIGRATION_COURT", "title": "Corte de inmigración" },
              { "id": "OTHER", "title": "Otro" }
            ]
          },
          { "type": "Footer", "label": "Continuar", "on-click-action": { "name": "navigate", "next": { "type": "screen", "name": "IMMIGRATION_DETAILS" }, "payload": { "topic": "${form.topic}" } } }
        ]
      }
    },
    {
      "id": "IMMIGRATION_DETAILS",
      "title": "Tus datos",
      "terminal": true,
      "success": true,
      "data": { "topic": { "type": "string", "__example__": "CONSULTATION" } },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextInput", "name": "full_name", "label": "Nombre completo", "required": true },
          { "type": "TextArea", "name": "description", "label": "Tu situación", "required": true },
          { "type": "TextInput", "name": "postal_code", "label": "ZIP / código postal", "input-type": "number", "required": false },
          { "type": "Footer", "label": "Solicitar orientación", "on-click-action": { "name": "complete", "payload": { "intake_type": "IMMIGRATION", "topic": "${data.topic}", "full_name": "${form.full_name}", "postal_code": "${form.postal_code}", "description": "${form.description}" } } }
        ]
      }
    }
  ]
}
